# Test scaffolding — regenerate with: cd test && npm install && node make-fixtures.mjs
test/node_modules/
test/vendor/
test/fixtures/
test/shots/
test/harness.html
test/package.json
test/package-lock.json

node_modules/
.DS_Store

# Plugin zip is a build output — rebuild with: node build-plugin-zip.mjs
# (kept in the repo so it can be downloaded without Node installed)
dist/_staging/

# Dev-only render checks
dist/publications/shots/

# Symlink to test/node_modules so build-docs.mjs can find playwright
/node_modules
test/videos-harness.html
test/team-harness.html

# Reference archive of the old site (uploaded by the client) - too heavy for git.
# Only the handful of images the preview embeds are kept.
assets/site-src/html/
assets/site-src/css/
assets/site-src/js/
site/dist/

# Root lockfile: local npm installs create this; the deploy uses npm install.
package-lock.json
